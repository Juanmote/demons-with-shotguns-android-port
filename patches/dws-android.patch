+			Vector2 withSpace = first.GetMeshDimensionsForString("E E");
+			Vector2 without = first.GetMeshDimensionsForString("EE");
+			float measured = (withSpace.x - without.x) * parts[0].lossyScale.x;
+			if (measured > 0.01f)
+			{
+				space = measured;
+			}
+		}
+		Bounds b0 = renderers[0].bounds;
+		Bounds b1 = renderers[1].bounds;
+		Bounds b2 = renderers[2].bounds;
+		float total = b0.size.x + space + b1.size.x + space + b2.size.x;
+		float center = (b0.min.x + b2.max.x) * 0.5f;
+		float left = center - total * 0.5f;
+		float[] targets = new float[3] { left, left + b0.size.x + space, left + b0.size.x + space + b1.size.x + space };
+		Bounds[] bounds = new Bounds[3] { b0, b1, b2 };
+		for (int j = 0; j < 3; j++)
+		{
+			parts[j].position += new Vector3(targets[j] - bounds[j].min.x, 0f, 0f);
+		}
