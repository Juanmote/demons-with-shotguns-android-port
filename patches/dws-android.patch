+		// Port Android: entrada nueva "Extras del port" al final de Opciones. Se copia la de idioma y
+		// las nueve entradas se reparten en el mismo espacio que ocupaban las ocho originales.
+		private tk2dTextMesh _dwsExtrasText;
+
+		private tk2dTextMesh _dwsExtrasOutline;
+
+		private void DwsAddExtrasOption()
+		{
+			try
+			{
+				List<tk2dUIItem> items = View.OptionsUIItems;
+				List<GameObject> cursors = View.OptionsCursorIndices;
+				if (items.Count != 8 || cursors.Count != 8)
+				{
+					return;
+				}
+				GameObject src = View.FullscreenButton.gameObject;
+				GameObject button = UnityEngine.Object.Instantiate(src, src.transform.parent);
+				button.name = "DwsExtrasButton";
+				tk2dUIItem item = button.GetComponent<tk2dUIItem>();
+				if (item != null)
+				{
+					item.enabled = false; // no debe cambiar el idioma al tocarla
+				}
+				Transform textTr = button.transform.Find("ButtonGraphic/Text");
+				_dwsExtrasText = textTr != null ? textTr.GetComponent<tk2dTextMesh>() : null;
+				Transform outlineTr = textTr != null ? textTr.Find("Text 1") : null;
+				_dwsExtrasOutline = outlineTr != null ? outlineTr.GetComponent<tk2dTextMesh>() : null;
+				if (_dwsExtrasText == null)
+				{
+					UnityEngine.Object.Destroy(button);
+					return;
+				}
+				GameObject cursorSrc = cursors[7];
+				GameObject cursor = UnityEngine.Object.Instantiate(cursorSrc, cursorSrc.transform.parent);
+				cursor.name = "DwsExtrasCursorIndex";
+				float top = items[0].transform.localPosition.y;
+				float bottom = items[7].transform.localPosition.y;
+				float cursorOffset = cursors[0].transform.localPosition.y - top;
+				items.Add(item);
+				cursors.Add(cursor);
+				View.OptionsButtonTextMeshes.Add(_dwsExtrasText);
+				float step = (top - bottom) / 8f;
+				for (int i = 0; i < 9; i++)
+				{
+					Transform b = (i < 8) ? items[i].transform : button.transform;
+					Vector3 p = b.localPosition;
+					p.y = top - step * i;
+					b.localPosition = p;
+					Vector3 c = cursors[i].transform.localPosition;
+					c.y = p.y + cursorOffset;
+					cursors[i].transform.localPosition = c;
+				}
+				DwsSetExtrasLabel();
+			}
+			catch (Exception e)
+			{
+				DwsLog.Write("No se pudo añadir Extras a Opciones: " + e);
+			}
+		}
+
+		private void DwsSetExtrasLabel()
+		{
+			string label = Loc.Spanish ? "Extras del port" : "Port extras";
+			if (_dwsExtrasText != null)
+			{
+				_dwsExtrasText.text = label;
+			}
+			if (_dwsExtrasOutline != null)
+			{
+				_dwsExtrasOutline.text = label;
+			}
 		}
 
 		public void OnSpecificTarotCardToggle(int tarotCard)
