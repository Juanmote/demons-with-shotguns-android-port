+		ZWrite Off Lighting Off Cull Off Fog { Mode Off }
+		Blend One OneMinusSrcAlpha
+		LOD 110
+		Pass {
+			CGPROGRAM
 			#pragma vertex vert
 			#pragma fragment frag
-
-			float4x4 unity_ObjectToWorld;
