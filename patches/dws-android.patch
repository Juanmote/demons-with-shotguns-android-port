 	}
 
+	// Port Android: la primera línea son tres textos colocados a mano para el inglés
+	// ("THE FOLLOWING" / "GAME" / "HAS BEEN APPROVED FOR"). Traducidos quedaban huecos desiguales,
+	// así que se vuelven a encadenar con el mismo espacio entre ellos y la línea centrada donde estaba.
+	private IEnumerator DwsFixFirstLine()
+	{
+		yield return null;
+		if (!Loc.Spanish)
+		{
+			yield break;
+		}
+		Transform[] parts = new Transform[3];
+		string[] names = new string[3] { "The Following", "Game", "Has Been Approved" };
+		Renderer[] renderers = new Renderer[3];
+		for (int i = 0; i < 3; i++)
+		{
+			GameObject go = GameObject.Find(names[i]);
+			if (go == null)
+			{
+				yield break;
+			}
+			tk2dTextMesh mesh = go.GetComponent<tk2dTextMesh>();
+			if (mesh != null)
+			{
+				mesh.ForceBuild();
+			}
+			parts[i] = go.transform;
+			renderers[i] = go.GetComponent<Renderer>();
+			if (renderers[i] == null)
+			{
